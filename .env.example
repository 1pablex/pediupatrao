# Copie este arquivo para .env e ajuste os valores.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pediupatrao

# Senhas dos usuarios criados na primeira execucao (admin, gerente01, atendente01).
# Minimo de 8 caracteres. Sem senha definida, o usuario nao e criado.
SEED_SENHA_ADMIN=
SEED_SENHA_GERENTE=
SEED_SENHA_ATENDENTE=

# true = gera 90 dias de pedidos ficticios para demonstrar o dashboard.
# Executa apenas se o banco ainda nao tiver pedidos (use um MONGODB_DATABASE proprio para a demonstracao).
DEMO_GERAR_DADOS=false
